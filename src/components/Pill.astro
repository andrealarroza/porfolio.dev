---
interface Props {
  class?: string
}

const { class: className = "" } = Astro.props
---

<span
  class={`inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-800 border border-gray-200 dark:bg-white/5 dark:text-gray-300 dark:border-white/10 ${className}`}
>
  <slot />
</span>
