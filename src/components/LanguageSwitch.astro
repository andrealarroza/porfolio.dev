---
import { getAlternateUrl, type Lang } from "@/i18n/utils"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const options: Lang[] = ["es", "en"]
---

<div
  class="flex items-center p-0.5 text-xs font-medium rounded-full bg-gray-200/60 dark:bg-white/10"
  role="group"
  aria-label="Idioma / Language"
>
  {
    options.map((code) => (
      <a
        href={getAlternateUrl(Astro.url, code)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? "true" : undefined}
        class:list={[
          "px-2 py-1 uppercase rounded-full transition-colors",
          code === lang
            ? "bg-pink-400 text-black"
            : "text-gray-600 dark:text-gray-300 hover:text-pink-500 dark:hover:text-pink-400",
        ]}
      >
        {code}
      </a>
    ))
  }
</div>