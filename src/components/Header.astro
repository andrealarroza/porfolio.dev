---
import { useTranslations, type Lang } from "@/i18n/utils"
import LanguageSwitch from "./LanguageSwitch.astro"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const home = lang === "es" ? "/" : "/en/"

const navItems = [
  {
    title: t("nav.experience"),
    label: t("section.experience.id"),
    url: `${home}#${t("section.experience.id")}`,
  },
  {
    title: t("nav.projects"),
    label: t("section.projects.id"),
    url: `${home}#${t("section.projects.id")}`,
  },
  {
    title: t("nav.about"),
    label: t("section.about.id"),
    url: `${home}#${t("section.about.id")}`,
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
  class="header-nav [--nav-bg:rgb(255_255_255/0.6)] dark:[--nav-bg:rgb(17_24_39/0.8)] flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full text-gray-600 dark:text-gray-300 justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-pink-500 dark:hover:text-pink-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <div class="ml-2 pl-2 border-l border-gray-300/30 dark:border-white/10">
      <LanguageSwitch lang={lang} />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a.nav-link")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-pink-500", "dark:text-pink-400", "bg-pink-400/10")
              item.classList.remove("text-gray-600", "dark:text-gray-300")
            } else {
              item.classList.remove("text-pink-500", "dark:text-pink-400", "bg-pink-400/10")
              item.classList.add("text-gray-600", "dark:text-gray-300")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    background-color: transparent;
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .nav-link.text-pink-500 {
    font-weight: 600;
  }

  @keyframes nav-appear {
    from {
      background-color: transparent;
      border-color: transparent;
      box-shadow: none;
      backdrop-filter: blur(0);
    }
    to {
      background-color: var(--nav-bg);
      border-color: rgb(156 163 175 / 0.2);
      box-shadow:
        0 10px 15px -3px rgb(0 0 0 / 0.1),
        0 4px 6px -4px rgb(0 0 0 / 0.1),
        0 0 0 1px rgb(255 255 255 / 0.08);
      backdrop-filter: blur(12px);
    }
  }
</style>
