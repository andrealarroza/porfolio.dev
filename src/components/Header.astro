---
import { useTranslations, type Lang } from "@/i18n/utils"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const home = lang === "es" ? "/" : "/en/"

const navItems = [
  {
    title: t("nav.experience"),
    label: t("section.experience.id"),
    url: `${home}#${t("section.experience.id")}`,
  },
  {
    title: t("nav.projects"),
    label: t("section.projects.id"),
    url: `${home}#${t("section.projects.id")}`,
  },
  {
    title: t("nav.about"),
    label: t("section.about.id"),
    url: `${home}#${t("section.about.id")}`,
  },
  {
    title: t("nav.contact"),
    label: "contact",
    url: "mailto:andrealarroza.dev@gmail.com",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full text-gray-600 dark:text-gray-300 justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-yellow-500 dark:hover:text-yellow-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a.nav-link")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500", "dark:text-yellow-400", "bg-yellow-400/10")
              item.classList.remove("text-gray-600", "dark:text-gray-300")
            } else {
              item.classList.remove("text-yellow-500", "dark:text-yellow-400", "bg-yellow-400/10")
              item.classList.add("text-gray-600", "dark:text-gray-300")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .header-nav {
    @apply dark:bg-gray-900/80 bg-white/60;
  }

  .nav-link.text-yellow-500 {
    @apply font-semibold;
  }

  @keyframes nav-appear {
    0% {
      @apply dark:bg-gray-900/0 bg-white/0 border-transparent shadow-none;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur-md ring-white/10 dark:ring-white/5 border-gray-200/20 dark:border-white/5;
    }
  }
</style>
