---
const personalImageAlt = "Andrea Larroza"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
import SocialPill from "@/components/SocialPill.astro"
import { useTranslations, type Lang } from "@/i18n/utils"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
---

<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-pink-400/30 dark:bg-pink-400/20 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-20 ring-2 ring-pink-400/60 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-950"
        src="/andy.webp"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/andrea-larroza"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> {t("hero.available")}</Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {t("hero.greeting")} <span class="gradient-name">Andy</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-gray-800 dark:[&>strong]:text-pink-400 [&>strong]:text-pink-500 [&>strong]:font-semibold dark:text-gray-300"
    set:html={t("hero.description")}
  >
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label={t("hero.social.label")}
  >
    <SocialPill href="mailto:andrealarroza.dev@gmail.com">
      <MailIcon class="size-4" />
      {t("hero.contact")}
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/andrea-larroza">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
